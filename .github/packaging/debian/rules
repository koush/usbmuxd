#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/usr --localstatedir=/var --runstatedir=/run --with-systemdsystemunitdir=/usr/lib/systemd/system --with-udevrulesdir=/usr/lib/udev/rules.d

# Run before systemd's 73-seat-late.rules applies desktop-session ACLs.
override_dh_installudev:
	dh_installudev --priority=70

# usbmuxd is activated by device events, not enabled at boot.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
